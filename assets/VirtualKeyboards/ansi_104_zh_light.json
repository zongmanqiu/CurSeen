{
  "name": "ANSI 104 轻立体",
  "base_layout": "ansi_104",
  "_说明": "白底细边框键帽 + 2px 底部微影（侧壁），按下变灰并下压 2px。设计变量：键帽 #FFFFFF / 边框 #D1D5DA / 功能键 #E4E7EA / 按下 #EBEBEB。适合白天浅色桌面，反馈轻但清楚。",
  "defaults": {
    "font_size": 15,
    "corner_radius": 6,
    "opacity": 1.0
  },
  "styles": {
    "input": {
      "label": "输入键",
      "fill": "#FFFFFF",
      "text": "#333333",
      "border": "#D1D5DA",
      "side": "#00000018",
      "depth": 2,
      "press": "#D5DBE2"
    },
    "func": {
      "label": "功能键",
      "fill": "#E4E7EA",
      "text": "#555555",
      "border": "#D1D5DA",
      "side": "#00000015",
      "depth": 2,
      "press": "#C9CFD7"
    }
  },
