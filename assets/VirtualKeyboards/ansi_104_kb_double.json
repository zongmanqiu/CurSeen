{
  "name": "ANSI 104 双层键帽",
  "base_layout": "ansi_104",
  "_说明": "仿机械键盘套件的双层键帽：外层『裙边』（侧壁色）+ 内缩的『顶面』（键帽色），按下时顶面沉入裙边色。配色取 Dracula 键帽预设（#282A36 / #44475A / 紫 #BD93F9 点缀）。裙边色/厚度可在面板调；把厚度拖到 0 可退回平面键帽。",
  "defaults": {
    "font_size": 13,
    "corner_radius": 5,
    "opacity": 1.0
  },
  "styles": {
    "input": {
      "label": "输入键",
      "fill": "#282A36",
      "text": "#F8F8F2",
      "border": "#00000000",
      "side": "#44475A",
      "depth": 5,
      "press": "#44475A"
    },
    "func": {
      "label": "功能键",
      "fill": "#21222C",
      "text": "#F8F8F2",
      "border": "#00000000",
      "side": "#6272A4",
      "depth": 5,
      "press": "#6272A4"
    }
  },
